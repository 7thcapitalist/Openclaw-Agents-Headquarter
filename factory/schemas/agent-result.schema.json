{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-result.schema.json",
  "title": "Factory Agent Result",
  "type": "object",
  "required": ["version", "dispatchId", "stage", "actor", "outcome", "summary", "evidence"],
  "properties": {
    "version": { "const": 1 },
    "dispatchId": { "type": "string", "minLength": 1 },
    "stage": { "enum": ["product", "architect", "builder", "reviewer", "qa", "security", "release"] },
    "actor": { "type": "string", "minLength": 1 },
    "outcome": { "enum": ["pass", "fail", "decision-required"] },
    "summary": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
