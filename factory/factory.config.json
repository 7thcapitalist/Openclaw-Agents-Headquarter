{
  "version": 1,
  "mode": "human-merge",
  "controlPlane": "github",
  "orchestrator": "openclaw",
  "taskSource": "github-issues",
  "gitWorkflow": {
    "_doc": "Repository-wide invariant (SFD-2026-008, docs/software-factory/GIT_WORKFLOW.md). Applies to every actor: founder, Claude, Codex, Cursor, factory agents, automated recovery, QA, infra jobs.",
    "model": "main-only",
    "permanentBranch": "main",
    "changeUnit": "pull-request",
    "prTarget": "main",
    "directPushToMain": false,
    "ephemeralBranches": true,
    "longLivedBranches": false,
    "longLivedWorktrees": false,
    "deleteBranchAfterMerge": true,
    "deleteWorktreeAfterMerge": true,
    "startFromLatestMain": true,
    "campaignPolicy": {
      "enabledOnlyWithFounderAuthorization": true,
      "sharedBaseAllowed": true,
      "separateBranchAndWorktreePerChange": true,
      "prTarget": "main",
      "integrationBranchesAllowed": false,
      "dependencyAndMergeOrderRequired": true,
      "refreshAgainstLatestMainBeforeMerge": true,
      "reverifyAfterRefresh": true,
      "policyDecision": "SFD-2026-010"
    },
    "policyDoc": "docs/software-factory/GIT_WORKFLOW.md"
  },
  "openclawIntegration": {
    "protocolVersion": 1,
    "maxAttemptsPerStage": 3,
    "maxRecoveryAttempts": 3,
    "_concurrentGroupsDoc": "Each inner array is a set of pipeline stages the runner dispatches concurrently once the branch is frozen (builder done). The engine still applies results one at a time and all gates are unchanged. Set to [] to force fully sequential.",
    "concurrentGroups": [
      [
        "reviewer",
        "qa",
        "security"
      ]
    ],
    "agentIds": {
      "_doc": "Keys are stages or '<stage>:<harness-token>' routing tokens; values are OpenClaw runtime agent ids. decompose and intake use the proven architect route while defaulting safely to main in code if these optional keys are absent. builder:frontend maps the dedicated Codex-backed frontend-builder agent. qa:claude and qa:codex point at the Claude-backed qa agent; builder/reviewer/QA independence is enforced by task-workflow.mjs.",
      "decompose": "architect",
      "intake": "architect",
      "product": "product",
      "architect": "architect",
      "builder:codex": "backend-builder",
      "builder:frontend": "frontend-builder",
      "builder:claude": "architect",
      "reviewer": "reviewer",
      "qa:claude": "qa",
      "qa:codex": "qa",
      "security": "security",
      "release": "release",
      "openclaw": "main",
      "learning": "learning",
      "recovery": "architect",
      "recovery-verify": "backend-builder",
      "research": "research"
    }
  },
  "learning": {
    "injectIntoHandoff": false,
    "evidenceRetentionDays": 90,
    "patternThreshold": 2,
    "autonomy": {
      "_doc": "Governs `factory-learn.mjs cycle`, the scheduled 3-day retrospective + mastery pass. Autonomous merge is PROPOSED, not accepted: see DECISIONS.md SFD-2026-011 and decision-cards/DC-2026-002. `enabled` ships false; turning it on is a founder decision that supersedes SFD-2026-003 and SFD-2026-008 for the whitelisted class.",
      "enabled": false,
      "cadenceDays": 3,
      "lookbackDays": 30,
      "whitelist": [
        "knowledge-append"
      ],
      "maxAutoMergesPerRun": 2,
      "research": {
        "allowlist": [
          "docs.openclaw.ai",
          "github.com/openclaw",
          "modelcontextprotocol.io",
          "www.anthropic.com",
          "platform.openai.com"
        ],
        "maxCallsPerRun": 10
      },
      "mastery": {
        "rotation": [
          "product",
          "architect",
          "backend-builder",
          "frontend-builder",
          "reviewer",
          "qa",
          "security",
          "release"
        ],
        "deepDiveRolesPerCycle": 1,
        "dossierDir": "factory/knowledge/agents"
      }
    }
  },
  "deploy": {
    "defaultProvider": "vercel",
    "providers": [
      "vercel",
      "none"
    ]
  },
  "founderInteraction": {
    "default": "chief-of-staff-decides",
    "maxQuestionsAtIntake": 1,
    "askOnlyWhen": [
      "material product direction",
      "privacy or security posture",
      "meaningful spend",
      "destructive production action",
      "no safe progress"
    ],
    "deferNonBlockingDecisionsUntil": "merge-ready"
  },
  "pipeline": [
    "product",
    "architect",
    "builder",
    "reviewer",
    "qa",
    "security",
    "release"
  ],
  "roles": {
    "chiefOfStaff": {
      "runtime": "openclaw",
      "responsibility": "specify, classify, route, summarize, escalate"
    },
    "architect": {
      "preferredHarness": "claude",
      "runtime": "acp",
      "writeAccess": false,
      "responsibility": "technical design and architecture challenge"
    },
    "product": {
      "runtime": "openclaw",
      "writeAccess": false,
      "responsibility": "normalize outcome and acceptance criteria"
    },
    "builder": {
      "preferredHarness": "codex",
      "runtime": "native-codex-or-acp",
      "writeAccess": true,
      "responsibility": "implementation, tests, branch, PR"
    },
    "productBuilder": {
      "preferredHarness": "codex",
      "runtime": "native-codex-or-acp",
      "writeAccess": true,
      "responsibility": "UI implementation and visual iteration"
    },
    "reviewer": {
      "selection": "different-model-from-builder",
      "writeAccess": false,
      "responsibility": "independent code/product/security review"
    },
    "qa": {
      "selection": "different-harness-from-builder",
      "responsibility": "verify acceptance criteria and attempt failure cases"
    },
    "security": {
      "preferredHarness": "claude",
      "writeAccess": false,
      "responsibility": "independent security and privacy gate"
    },
    "releaseManager": {
      "runtime": "deterministic-gates-plus-openclaw",
      "responsibility": "verify merge readiness and surface blockers"
    }
  },
  "routing": {
    "ui": "frontend",
    "backend": "codex",
    "architecture": "claude",
    "bugfix": "codex",
    "review": "different-model",
    "qa-ui": "codex",
    "qa-backend": "codex-or-claude"
  },
  "risk": {
    "low": {
      "founderApprovalBeforeBuild": false,
      "founderMergeRequired": true
    },
    "medium": {
      "founderApprovalBeforeBuild": false,
      "founderMergeRequired": true
    },
    "high": {
      "founderApprovalBeforeBuild": true,
      "founderMergeRequired": true
    }
  },
  "prohibitedAutonomousActions": [
    "push-to-main",
    "production-deploy",
    "production-data-deletion",
    "secret-rotation",
    "paid-purchase",
    "public-publishing",
    "billing-change"
  ],
  "requiredGates": [
    "acceptance-criteria",
    "verification",
    "independent-review",
    "qa-evidence",
    "no-unresolved-strategic-decision"
  ]
}
