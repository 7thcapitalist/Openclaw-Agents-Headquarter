{
  "version": 1,
  "mode": "human-merge",
  "controlPlane": "github",
  "orchestrator": "openclaw",
  "taskSource": "github-issues",
  "openclawIntegration": {
    "protocolVersion": 1,
    "maxAttemptsPerStage": 3,
    "agentIds": {
      "_doc": "builder:cursor intentionally points at the dedicated 'frontend-builder' OpenClaw agent, not the 'cursor' runtime agent. The 'cursor' agent's ACP integration does not reliably invoke real Cursor sessions (verified: silently falls back to the embedded model with no error). See factory/agents.json's frontend-builder.notes for the full finding. Do not repoint this at 'cursor' without first verifying a real fix on the OpenClaw side. qa:claude and qa:codex both point at the one 'qa' OpenClaw agent, which is Claude-backed via acpx as of 2026-09-05 (previously qa:claude was a 'reviewer' stand-in); independence still holds because the pipeline assigns QA a different harness token from the builder.",
      "product": "product",
      "architect": "architect",
      "builder:codex": "backend-builder",
      "builder:cursor": "frontend-builder",
      "builder:claude": "architect",
      "reviewer": "reviewer",
      "qa:claude": "qa",
      "qa:codex": "qa",
      "security": "security",
      "release": "release",
      "openclaw": "main",
      "learning": "learning",
      "research": "research"
    }
  },
  "learning": {
    "injectIntoHandoff": false,
    "evidenceRetentionDays": 90,
    "patternThreshold": 2
  },
  "pipeline": [
    "product",
    "architect",
    "builder",
    "reviewer",
    "qa",
    "security",
    "release"
  ],
  "roles": {
    "chiefOfStaff": {
      "runtime": "openclaw",
      "responsibility": "specify, classify, route, summarize, escalate"
    },
    "architect": {
      "preferredHarness": "claude",
      "runtime": "acp",
      "writeAccess": false,
      "responsibility": "technical design and architecture challenge"
    },
    "product": {
      "runtime": "openclaw",
      "writeAccess": false,
      "responsibility": "normalize outcome and acceptance criteria"
    },
    "builder": {
      "preferredHarness": "codex",
      "runtime": "native-codex-or-acp",
      "writeAccess": true,
      "responsibility": "implementation, tests, branch, PR"
    },
    "productBuilder": {
      "preferredHarness": "cursor",
      "runtime": "acp",
      "writeAccess": true,
      "responsibility": "UI implementation and visual iteration"
    },
    "reviewer": {
      "selection": "different-model-from-builder",
      "writeAccess": false,
      "responsibility": "independent code/product/security review"
    },
    "qa": {
      "selection": "different-harness-from-builder",
      "responsibility": "verify acceptance criteria and attempt failure cases"
    },
    "security": {
      "preferredHarness": "claude",
      "writeAccess": false,
      "responsibility": "independent security and privacy gate"
    },
    "releaseManager": {
      "runtime": "deterministic-gates-plus-openclaw",
      "responsibility": "verify merge readiness and surface blockers"
    }
  },
  "routing": {
    "ui": "cursor",
    "backend": "codex",
    "architecture": "claude",
    "bugfix": "codex",
    "review": "different-model",
    "qa-ui": "cursor",
    "qa-backend": "codex-or-claude"
  },
  "risk": {
    "low": { "founderApprovalBeforeBuild": false, "founderMergeRequired": true },
    "medium": { "founderApprovalBeforeBuild": false, "founderMergeRequired": true },
    "high": { "founderApprovalBeforeBuild": true, "founderMergeRequired": true }
  },
  "prohibitedAutonomousActions": [
    "push-to-main",
    "production-deploy",
    "production-data-deletion",
    "secret-rotation",
    "paid-purchase",
    "public-publishing",
    "billing-change"
  ],
  "requiredGates": [
    "acceptance-criteria",
    "verification",
    "independent-review",
    "qa-evidence",
    "no-unresolved-strategic-decision"
  ]
}
