{
  "name": "openclaw-startup-hq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm install --prefix dashboard/backend",
    "seed:hq": "AGENT_LAB_ROOT=$PWD ./scripts/seed-hq.sh",
    "dev": "AGENT_LAB_ROOT=$PWD npm --prefix dashboard/backend run dev",
    "start": "AGENT_LAB_ROOT=$PWD npm --prefix dashboard/backend start",
    "test:factory": "node --test factory/test/*.test.mjs",
    "factory:openclaw": "node scripts/openclaw-factory.mjs",
    "factory:intel": "node scripts/project-intel.mjs",
    "factory:hq": "node scripts/hq.mjs",
    "factory:learn": "node scripts/factory-learn.mjs",
    "factory:smoke": "node scripts/factory-smoke.mjs",
    "factory:smoke:github": "node scripts/factory-smoke-github.mjs",
    "factory:run-many": "node scripts/factory-run-many.mjs",
    "factory:prune-sessions": "node scripts/prune-factory-sessions.mjs",
    "factory:route-review": "node scripts/apply-review-model-routing.mjs",
    "register:example": "AGENT_LAB_ROOT=$PWD ./scripts/register-agent.sh example-project research-analyst"
  }
}
