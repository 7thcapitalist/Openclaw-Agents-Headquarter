DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000
DASHBOARD_PASSWORD=change-me
DASHBOARD_SESSION_SECRET=replace-with-a-long-random-string
DASHBOARD_TRUST_PROXY=0
DASHBOARD_HTTPS=0

# Optional: point the dashboard at a different Agent Lab root.
# AGENT_LAB_ROOT=/absolute/path/to/openclaw-startup-hq

# Optional deployment-provider credentials. Supply values through the local
# environment or OpenClaw secret store; never put them in deploy.config.json.
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_ORG_ID=
