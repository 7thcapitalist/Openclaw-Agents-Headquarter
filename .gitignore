node_modules/
.env
.env.*
!.env.example

# Runtime data
dashboard/backend/data/
.openclaw-factory/
.openclaw-worktrees/

# Factory process artifacts — gate evidence, agent scratch, synthetic
# infra-failure notes. These belong to a task's run, never to the product,
# and must not be swept into a task branch by `git add -A` at publish time.
evidence/
/*-qa.test.log
/*-qa.exitcode
/*-qa.summary.md
/*.exitcode
agents/**/logs/*
agents/**/outputs/*
!agents/**/logs/.gitkeep
!agents/**/outputs/.gitkeep

# Local OpenClaw state and secrets should never be committed.
.openclaw/
openclaw.json
/IDENTITY.md
/SOUL.md
/USER.md
/MEMORY.md
credentials/
secrets/
memory/
tasks/
flows/
cron/
devices/
identity/
/.openclaw/logs/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# OS/editor
.DS_Store
Thumbs.db
